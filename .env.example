# Adaptive Campus Security Patrol Planning and Coverage Agent
# Lovely Professional University (LPU), Punjab, India

# Google Maps Platform Browser API Key (Maps JavaScript API)
# Restrict in Google Cloud Console -> Credentials -> Application restrictions -> Websites (HTTP referrers)
# e.g.: http://localhost:5173/*
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Gmail 2FA OTP Delivery Configuration (Optional - for live Gmail inbox dispatch)
# To enable real Gmail delivery:
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
